meta {
  name: Exec echo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/vm/{{sessionId}}/exec
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "cmd": "echo",
    "args": ["hello from sherd-vm"]
  }
}

assert {
  res.status: eq 200
  res.body.exit_code: eq 0
}
