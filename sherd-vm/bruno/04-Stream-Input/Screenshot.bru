meta {
  name: Screenshot
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/vm/{{sessionId}}/screenshot?format=png
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

docs {
  Returns { data_base64, format } — PNG bytes as base64.
  Try ?format=jpeg&quality=70 for smaller.
}

assert {
  res.status: eq 200
}
