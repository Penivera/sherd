vars {
  baseUrl: http://localhost:8765
  authUrl: http://localhost:8000
  # Paste a JWT from sherd-auth (POST /auth/login) if you want auth-checked requests
  # Leave empty for local demo — sherd-vm allows unauthenticated when auth service is unreachable
  authToken: 
  # Filled automatically after Create VM — or paste a known session_id
  sessionId: 
}

vars:secret [
  authToken
]
