# Solari API key (required) — get from https://console.getsolari.com/keys
# Format: slr_live_<id>_<secret>
SOLARI_API_KEY=slr_live_...

# Optional overrides
SOLARI_BASE_URL=https://api.getsolari.com
SOLARI_REGION=us-west
SOLARI_TEMPLATE=default
SOLARI_RESOLUTION=1280x720

# Sherd auth service for JWT validation (used by sherd-vm HTTP bridge)
SHERD_AUTH_URL=http://localhost:8000
# Fallback for desktop client
VITE_API_BASE_URL=http://localhost:8000

# VM daemon HTTP bridge (for desktop client)
VITE_VM_BASE_URL=http://localhost:8765
SHERD_VM_SOCKET=sherd-vm.sock
SHERD_IPC_SOCKET=sherd-ipc.sock

# Logging
RUST_LOG=info
